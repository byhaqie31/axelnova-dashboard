# Production .env template for axelnova-dashboard frontend.
#
# On VPS:
#   cp frontend/.env.production.example frontend/.env.production
#   vim frontend/.env.production

# Browser-side base URL for backend API calls. The API lives on the admin host
# (nginx on the VPS proxies /api/* to 127.0.0.1:8003 on every host): same-origin
# for the admin panel, cross-origin for public pages on axelnovaventures.com
# (allowed by backend config/cors.php). /api is never redirected off this host.
NUXT_PUBLIC_API_BASE=https://admin.axelnovaventures.com

# Public site origin (canonical, og:url, redirects) and the internal admin host.
# Both default to production values in nuxt.config.ts — set only to override.
# On the admin host every page outside /admin (and the portals) 301s to the
# public site, and every response carries X-Robots-Tag: noindex.
# NUXT_PUBLIC_SITE_URL=https://axelnovaventures.com
# NUXT_ADMIN_HOST=admin.axelnovaventures.com

# Shared secret for POST /_cache/purge — must equal the backend's
# SITE_CACHE_PURGE_TOKEN. Blank → the route 404s and published blog changes
# wait out the 5-minute page cache. See docs/global/DEPLOY.md § Page caching.
NUXT_CACHE_PURGE_TOKEN=

# Signs generated link-preview image URLs (/_og/…). Must stay the same across
# deploys, or every previously shared preview image 403s. Generate once with
# `openssl rand -hex 32`. See docs/global/DEPLOY.md § OG image secret.
NUXT_OG_IMAGE_SECRET=
